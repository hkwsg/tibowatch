# Optional settings loaded by systemd from /etc/tibo-watch/runtime.env.
# Agent-assisted setup can fill these using the target server's actual paths.
TIBOWATCH_TRANSLATE=1
TIBOWATCH_CODEX_BIN=/usr/bin/codex
CODEX_HOME=/var/lib/tibo-watch/codex
# Reuse the deploying user's authorized existing login: minimal auth context only.
# Auth directory 0700, auth file 0600, both owned by tibo-watch.
# Set TIBOWATCH_TRANSLATE=0 for English-only forwarding.
# Setup details: ../DEPLOY_WITH_CODEX.md and ../docs/ENGINEERING.md.
