# Optional non-secret settings, loaded by systemd from /etc/tibo-watch/runtime.env.
# Use an installed CLI accessible outside the interactive user's home.
TIBOWATCH_TRANSLATE=1
TIBOWATCH_CODEX_BIN=/usr/bin/codex
# Reuse the existing ChatGPT/Codex account; no separate account/device-auth/API key.
# Manually provision only necessary auth here, not full home/config/history.
# Owned by tibo-watch: directory 0700, auth file 0600. Never commit auth contents.
CODEX_HOME=/var/lib/tibo-watch/codex
# Keep ProtectHome=true. No automatic sync; invalid auth means English fallback.
# Manually provision current valid auth again when needed.
