# Optional non-secret settings, loaded by systemd from /etc/tibo-watch/runtime.env.
# Use only an executable and CLI login already accessible to the service user.
TIBOWATCH_TRANSLATE=1
TIBOWATCH_CODEX_BIN=/usr/local/bin/codex
# Optional existing CLI auth home for tibo-watch; never commit its contents.
# CODEX_HOME=/var/lib/tibo-watch/codex
